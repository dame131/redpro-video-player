<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/black">
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="131 RED PLAYER" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold"/><ImageButton android:id="@+id/searchButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_search" android:contentDescription="Search" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/white"/><ImageButton android:id="@+id/moreButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_more" android:contentDescription="More" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/white"/></LinearLayout>
 <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/black" app:use_controller="true" app:show_buffering="when_playing" app:resize_mode="fit"/>
 <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Choose a video to begin" android:textColor="@color/white" android:textSize="15sp" android:maxLines="1" android:ellipsize="middle"/>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="58dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp"><Button android:id="@+id/openButton" style="@style/RedButton" android:text="ADD VIDEOS"/><Button android:id="@+id/subtitleButton" style="@style/DarkButton" android:text="SUBTITLES"/><Button android:id="@+id/speedButton" style="@style/DarkButton" android:text="SPEED 1×"/><Button android:id="@+id/fitButton" style="@style/DarkButton" android:text="FIT"/><Button android:id="@+id/abButton" style="@style/DarkButton" android:text="A–B"/><Button android:id="@+id/pipButton" style="@style/DarkButton" android:text="MINI"/><Button android:id="@+id/lockButton" style="@style/DarkButton" android:text="LOCK"/><Button android:id="@+id/infoButton" style="@style/DarkButton" android:text="INFO"/></LinearLayout></HorizontalScrollView>
 <TextView android:id="@+id/gestureText" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center" android:text="Swipe left: brightness • Swipe right: volume • Swipe across: seek" android:textColor="@color/muted" android:textSize="11sp"/>
 <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center" android:orientation="horizontal"><Button android:id="@+id/previousButton" style="@style/BottomButton" android:text="PREVIOUS"/><Button android:id="@+id/playlistButton" style="@style/BottomButton" android:text="PLAYLIST"/><Button android:id="@+id/nextButton" style="@style/BottomButton" android:text="NEXT"/><Button android:id="@+id/settingsButton" style="@style/BottomButton" android:text="SETTINGS"/></LinearLayout>
</LinearLayout>
