    <style name="RedButton" parent="Widget.MaterialComponents.Button"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">44dp</item><item name="android:layout_marginHorizontal">4dp</item><item name="backgroundTint">@color/red_player</item><item name="android:textColor">@color/text_on_accent</item></style>
