<resources>
    <style name="Theme.RedPlayer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/red_player</item>
        <item name="colorPrimaryVariant">@color/red_dark</item>
        <item name="colorSecondary">@color/red_player</item>
        <item name="colorAccent">@color/red_player</item>
        <item name="colorControlActivated">@color/red_player</item>
        <item name="colorControlHighlight">@color/red_dark</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorAccent">@color/red_player</item>
        <item name="android:colorControlActivated">@color/red_player</item>
        <item name="android:colorControlHighlight">@color/red_dark</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.RedPlayer.Dialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.RedPlayer.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RedPlayer.Dialog</item>
    </style>

    <style name="ThemeOverlay.RedPlayer.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/red_player</item>
        <item name="colorSecondary">@color/red_player</item>
        <item name="colorAccent">@color/red_player</item>
        <item name="colorControlActivated">@color/red_player</item>
        <item name="colorControlHighlight">@color/red_dark</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorAccent">@color/red_player</item>
        <item name="android:colorControlActivated">@color/red_player</item>
        <item name="android:colorControlHighlight">@color/red_dark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/panel</item>
    </style>

    <style name="ThemeOverlay.RedPlayer.Popup" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="colorPrimary">@color/red_player</item>
        <item name="colorSecondary">@color/red_player</item>
        <item name="colorControlHighlight">@color/red_dark</item>
        <item name="android:colorAccent">@color/red_player</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <style name="Theme.RedPlayer.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.RedPlayer</item>
    </style>
    <style name="RedButton" parent="Widget.MaterialComponents.Button"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">44dp</item><item name="android:layout_marginHorizontal">4dp</item><item name="backgroundTint">@color/red_player</item><item name="android:textColor">@color/white</item></style>
    <style name="DarkButton" parent="Widget.MaterialComponents.Button.OutlinedButton"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">44dp</item><item name="android:layout_marginHorizontal">4dp</item><item name="strokeColor">@color/red_player</item><item name="android:textColor">@color/white</item></style>
    <style name="BottomButton" parent="Widget.MaterialComponents.Button.TextButton"><item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item><item name="android:layout_weight">1</item><item name="android:textColor">@color/white</item><item name="android:textSize">10sp</item></style>
    <style name="RedIconButton" parent="Widget.AppCompat.ImageButton"><item name="android:layout_width">62dp</item><item name="android:layout_height">62dp</item><item name="android:layout_marginHorizontal">5dp</item><item name="android:padding">9dp</item><item name="android:background">@android:color/transparent</item><item name="android:elevation">7dp</item><item name="android:translationZ">3dp</item><item name="android:scaleType">fitCenter</item></style>
    <style name="BottomIconButton" parent="RedIconButton"><item name="android:layout_width">0dp</item><item name="android:layout_height">60dp</item><item name="android:layout_weight">1</item><item name="android:layout_marginHorizontal">2dp</item><item name="android:padding">11dp</item></style>
</resources>
