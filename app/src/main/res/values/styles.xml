    <style name="BottomButton" parent="Widget.MaterialComponents.Button.TextButton"><item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item><item name="android:layout_weight">1</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">10sp</item></style>
