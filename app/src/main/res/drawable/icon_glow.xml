<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:gravity="bottom" android:height="5dp" android:left="10dp" android:right="10dp">
                <shape android:shape="rectangle"><corners android:radius="3dp"/><solid android:color="@color/accent_orange"/></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item android:gravity="bottom" android:height="4dp" android:left="10dp" android:right="10dp">
                <shape android:shape="rectangle"><corners android:radius="3dp"/><solid android:color="@color/red_player"/></shape>
            </item>
        </layer-list>
    </item>
    <item><color android:color="@android:color/transparent"/></item>
</selector>
